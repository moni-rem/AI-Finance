rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt'
        ]);
      allow delete: if ownsUserData(userId);

      match /transactions/{transactionId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasAll([
            'name', 'category', 'date', 'amount', 'iconCode', 'colorValue', 'note'
          ])
          && request.resource.data.keys().hasOnly([
            'name', 'category', 'date', 'amount', 'iconCode', 'colorValue', 'note', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.category is string
          && request.resource.data.date is string
          && request.resource.data.amount is number
          && request.resource.data.iconCode is int
          && request.resource.data.colorValue is int
          && request.resource.data.note is string
          && request.resource.data.createdAt is timestamp;
      }

      match /budgets/{budgetId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasAll([
            'title', 'spent', 'limit', 'iconCode', 'colorValue'
          ])
          && request.resource.data.keys().hasOnly([
            'title', 'spent', 'limit', 'iconCode', 'colorValue'
          ])
          && request.resource.data.title is string
          && request.resource.data.spent is number
          && request.resource.data.limit is number
          && request.resource.data.iconCode is int
          && request.resource.data.colorValue is int;
      }

      match /goals/{goalId} {
        allow read, delete: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId)
          && request.resource.data.keys().hasAll([
            'title', 'saved', 'target', 'iconCode', 'colorValue'
          ])
          && request.resource.data.keys().hasOnly([
            'title', 'saved', 'target', 'iconCode', 'colorValue'
          ])
          && request.resource.data.title is string
          && request.resource.data.saved is number
          && request.resource.data.target is number
          && request.resource.data.iconCode is int
          && request.resource.data.colorValue is int;
      }
    }
  }
}
